# Copy to .env and fill in for local development.

# --- Database (SQL Server via Prisma) -----------------------------------
DATABASE_URL="sqlserver://localhost:1433;database=itservice;user=sa;password=CHANGE_ME;trustServerCertificate=true"

# --- Auth -----------------------------------------------------------------
# mock  -> no real login, pick a seeded user via MOCK_UPN / the login page
# entra -> real Entra ID (Azure AD) OIDC + Microsoft Graph /me
AUTH_MODE=mock
MOCK_UPN=

# only needed when AUTH_MODE=entra
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:3000/api/auth/callback

# --- App -------------------------------------------------------------------
# base URL used to build links inside emails and the loan-reminder cron
APP_BASE_URL=http://localhost:3000

# --- Mail -------------------------------------------------------------------
# log  -> write outgoing mail to the console instead of sending (default)
# smtp -> send for real via SMTP_*
MAIL_TRANSPORT=log
MAIL_FROM="IT Service <no-reply@tsmgroup.local>"
IT_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Scheduled jobs ----------------------------------------------------------
# shared secret required to call /api/cron/loan-reminders
CRON_SECRET=
